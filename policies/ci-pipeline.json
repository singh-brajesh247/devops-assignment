{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AuthenticateToECR",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "PushToAppRepository",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage",
        "ecr:BatchGetImage"
      ],
      "Resource": "arn:aws:ecr:us-east-1:000000000000:repository/dev-app"
    },
    {
      "Sid": "RegisterAppTaskDefinition",
      "Effect": "Allow",
      "Action": "ecs:RegisterTaskDefinition",
      "Resource": "arn:aws:ecs:us-east-1:000000000000:task-definition/dev-app:*"
    },
    {
      "Sid": "DeployAppService",
      "Effect": "Allow",
      "Action": "ecs:UpdateService",
      "Resource": "arn:aws:ecs:us-east-1:000000000000:service/dev-app-cluster/dev-app-service",
      "Condition": {
        "ArnEquals": {
          "ecs:cluster": "arn:aws:ecs:us-east-1:000000000000:cluster/dev-app-cluster"
        },
        "ArnLike": {
          "ecs:task-definition": "arn:aws:ecs:us-east-1:000000000000:task-definition/dev-app:*"
        }
      }
    },
    {
      "Sid": "WaitForAppDeployment",
      "Effect": "Allow",
      "Action": "ecs:DescribeServices",
      "Resource": "arn:aws:ecs:us-east-1:000000000000:service/dev-app-cluster/dev-app-service"
    },
    {
      "Sid": "PassOnlyAppTaskRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::000000000000:role/dev-app-task-role",
        "arn:aws:iam::000000000000:role/dev-app-execution-role"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ListArtifactBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::dev-ci-build-artifacts-000000000000"
    },
    {
      "Sid": "ReadBuildArtifacts",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::dev-ci-build-artifacts-000000000000/*"
    }
  ]
}
